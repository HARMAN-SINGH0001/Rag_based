from langchain_core.prompts import PromptTemplate
from langchain_ollama import ChatOllama

prompt = PromptTemplate(
    input_variables=["url"],
    template="Extract only the YouTube video ID from this URL: {url}"
)

url = "https://www.youtube.com/watch?v=J5_-l7WIO_w&t=74s"

final_prompt = prompt.invoke({"url": url})
model=ChatOllama(model='tinyllama:chat')
result=model.invoke(final_prompt)
print(result.content)
